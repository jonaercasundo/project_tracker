{

    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "types": ["node"]
    },
    "include": [
        "agents/**/*.ts",
        "browser/**/*.ts",
        "tools/**/*.ts",
        "tests/**/*.ts"
    ]
}
